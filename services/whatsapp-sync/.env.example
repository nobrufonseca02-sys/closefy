SUPABASE_URL=https://your-project-ref.supabase.co
# Lovable Cloud (recommended):
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Required: every worker_* RPC (leasing, session reporting, sync) is gated on
# this shared secret instead of a Supabase user session, since the worker
# never logs in as anyone. Generate a random value with at least 32 characters.
WHATSAPP_INTEGRATION_TOKEN=generate-a-random-secret-with-at-least-32-characters
# Standard Supabase alternative (also replaces supabaseKey above entirely if set):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# No service-role key needed for audio: the worker uploads voice notes by
# calling the whatsapp-audio-upload edge function with WHATSAPP_INTEGRATION_TOKEN
# above; that function gets a service-role client from Supabase itself.

# Multi-tenant: this worker leases and runs one WhatsApp connection per
# Closefy user who requests pairing (see worker_lease_whatsapp_sessions /
# worker_session_call). There is no fixed business number anymore — each
# session's own phone is whatever number its owner pairs.
# Parent folder; every session gets its own "<this>/<sessionId>/" subfolder.
WHATSAPP_AUTH_STATE_DIR=./auth_state
# How often (ms) the worker asks the database which sessions it should run.
# Must stay well under the 60s lease window so running sessions keep renewing.
WHATSAPP_LEASE_POLL_MS=20000

LOG_LEVEL=info
PORT=3003
