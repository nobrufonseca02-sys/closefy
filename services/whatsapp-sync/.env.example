SUPABASE_URL=https://your-project-ref.supabase.co
# Lovable Cloud (recommended):
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
WHATSAPP_INTEGRATION_TOKEN=generate-a-random-secret-with-at-least-32-characters
# Standard Supabase alternative (also replaces supabaseKey above entirely if set):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# No service-role key needed for audio: the worker uploads voice notes by
# calling the whatsapp-audio-upload edge function with WHATSAPP_INTEGRATION_TOKEN
# above; that function gets a service-role client from Supabase itself.

# This integration is intentionally locked to Nobru's business WhatsApp.
WHATSAPP_BUSINESS_PHONE_NUMBER=5521994177491
WHATSAPP_PAIRING_MODE=false
WHATSAPP_AUTH_STATE_DIR=./auth_state

LOG_LEVEL=info
PORT=3003
