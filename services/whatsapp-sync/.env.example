SUPABASE_URL=https://your-project-ref.supabase.co
# Lovable Cloud (recommended):
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
WHATSAPP_INTEGRATION_TOKEN=generate-a-random-secret-with-at-least-32-characters
# Standard Supabase alternative (also replaces supabaseKey above entirely if set):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Needed specifically so voice-note uploads can bypass the whatsapp-audio
# bucket's RLS (Storage has no SECURITY DEFINER-function equivalent to the
# worker_* RPC wrappers). Without it, audio messages still sync fine, they
# just keep the "🎵 Áudio" text placeholder instead of a playable file.
# Dashboard -> Project Settings -> API -> service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# This integration is intentionally locked to Nobru's business WhatsApp.
WHATSAPP_BUSINESS_PHONE_NUMBER=5521994177491
WHATSAPP_PAIRING_MODE=false
WHATSAPP_AUTH_STATE_DIR=./auth_state

LOG_LEVEL=info
PORT=3003
